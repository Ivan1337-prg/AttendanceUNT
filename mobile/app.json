{
  "expo": {
    "name": "EduVision Student",
    "slug": "eduvision-mobile",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow EduVision to use your location to verify classroom attendance."
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"]
  }
}
